<!DOCTYPE html>
<html>
<head>
  <title>Add Student</title>
</head>
<body>
  <h1>Add Student</h1>

  <% if (errors.length > 0) { %>
    <div class="error">
      <% errors.forEach(e => { %>
        <p><%= e %></p>
      <% }); %>
    </div>
  <% } %>

  <form action="/students/add" method="POST">
    <label>Student ID:</label><br>
    <input type="text" name="student_id" value="<%= student.student_id || '' %>"><br><br>

    <label>First Name:</label><br>
    <input type="text" name="first_name" value="<%= student.first_name || '' %>"><br><br>

    <label>Last Name:</label><br>
    <input type="text" name="last_name" value="<%= student.last_name || '' %>"><br><br>

    <label>Course:</label><br>
    <input type="text" name="course" value="<%= student.course || '' %>"><br><br>

    <label>Year Level:</label><br>
    <input type="text" name="year_level" value="<%= student.year_level || '' %>"><br><br>

    <label>Email:</label><br>
    <input type="text" name="email" value="<%= student.email || '' %>"><br><br>

    <button type="submit">Save Student</button>
  </form>

  <br>
  <a href="/">Back to Student List</a>
</body>
</html>